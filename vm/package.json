{
  "name": "purvasm-vm",
  "version": "0.1.0",
  "description": "The owned purvasm VM: a PureScript bytecode interpreter, compiled natively (ADR-0110)",
  "keywords": [
    "purescript",
    "purvasm"
  ],
  "license": "MIT",
  "author": "Katsujukou Kineya",
